# ==============================================================================
# Cambodia MSE Intelligence - Environment Configuration Template
# Copy this file to .env and fill in your custom credentials if needed:
#   cp .env.example .env
# ==============================================================================

# --- Telegram Mobile Alerting Engine ---
# Create a bot via @BotFather on Telegram to obtain BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# Send a message to @userinfobot to obtain your numeric CHAT_ID
TELEGRAM_CHAT_ID=

# Label displayed on mobile push notification headers
TELEGRAM_LOCATION="Phnom Penh Central Branch"

# --- Database & Storage Paths ---
DUCKDB_PATH="data/cambodia_mse.duckdb"
ODS_DB_PATH="data/sme_cambodia.duckdb"

# --- Streamlit Server Settings ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
